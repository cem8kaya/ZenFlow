    "advice_beginner_start" : {
      "comment" : "Beginner advice for new users",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're at the beginning of your journey. The Zen path requires patience and persistence. Take one small step each day—breathe, sit, observe. Don't seek perfection, just be."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yolculuğunun başındasın. Zen yolu sabır ve süreklilik gerektirir. Her gün küçük bir adım at - nefes al, otur, gözlemle. Mükemmellik arayışında olma, sadece var ol."
          }
        }
      }
    },
    "advice_general_encouragement" : {
      "comment" : "General advice",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your meditation journey is progressing well. Sometimes your mind will wander, sometimes it will be quiet. Both are natural. The important thing is to observe without judgment. You are not your thoughts; you are the observer of your thoughts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meditasyon yolculuğun güzel ilerliyor. Bazen zihin dağınık olacak, bazen sessiz. Her ikisi de doğaldır. Önemli olan, yargılamadan gözlemlemek. Sen düşüncen değilsin, düşüncelerin gözlemcisisin."
          }
        }
      }
    },
    "advice_mastery_progress" : {
      "comment" : "Advice for experienced users",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've completed %lld of your sessions. Meditation is now a part of your life. But the real transformation happens outside your pillow. How alert are you in your daily life? Every moment is an opportunity to practice."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld seans tamamladın. Meditasyon artık yaşamının bir parçası. Ancak asıl dönüşüm yastığın dışında gerçekleşir. Günlük yaşamda ne kadar uyanıksın? Her an bir uygulama fırsatıdır."
          }
        }
      }
    },
    "advice_returning_user" : {
      "comment" : "Advice for returning users",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You haven't meditated in a while. That's normal, life gets busy sometimes. But remember: The journey begins with a thousand miles. Start today with a small breath. Starting over is a sign of courage, not failure."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir süredir meditasyon yapmadın. Bu normaldir - hayat bazen bizleri meşgul eder. Ama unutma: Yolculuk bin bir millik yoldan başlar. Bugün küçük bir nefesle başla. Yeniden başlamak, başarısızlık değil, cesaret işaretidir."
          }
        }
      }
    },
    "advice_streak_maintenance" : {
      "comment" : "Advice for users with a streak",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're doing great with your %lld day streak! But remember: In Zen, the goal isn't to maintain the streak, but to live each moment fully. It's okay if the streak breaks, it's the present breath that counts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld günlük seride harikasın! Ancak unutma: Zen'de hedef, seriyi korumak değil, her anı tam yaşamaktır. Seri kırılırsa da sorun değil - önemli olan şimdiki nefes."
          }
        }
      }
    },
