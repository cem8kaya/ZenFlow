    "zen_backup_default" : {
      "comment" : "Default backup quote",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"The present moment is the only moment you have.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Şimdiki an, sahip olduğun tek andır.\""
          }
        }
      }
    },
    "zen_backup_quote_0" : {
      "comment" : "Backup Zen quote 0",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Water is flow, wind is blowing, flow is finding its rhythm.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Su akıştır, rüzgar esintir, akış ritmini bulmaktır.\""
          }
        }
      }
    },
    "zen_backup_quote_1" : {
      "comment" : "Backup Zen quote 1",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"The present moment is the only moment you have. Embrace it.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Şimdiki an, sahip olduğun tek andır. Onu kucakla.\""
          }
        }
      }
    },
    "zen_backup_quote_2" : {
      "comment" : "Backup Zen quote 2",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"When the mind is calm, the beauty of the soul shines.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Zihin sakinleştiğinde, ruhun güzelliği parlar.\""
          }
        }
      }
    },
    "zen_backup_quote_3" : {
      "comment" : "Backup Zen quote 3",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Every breath is a new beginning.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Her nefes, yeni bir başlangıçtır.\""
          }
        }
      }
    },
    "zen_backup_quote_4" : {
      "comment" : "Backup Zen quote 4",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Silence contains all the answers.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Sessizlik, tüm cevapları içerir.\""
          }
        }
      }
    },
    "zen_backup_quote_5" : {
      "comment" : "Backup Zen quote 5",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Enlightenment is not a distant goal, but awareness at every step.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Aydınlanma, uzaktaki bir hedef değil, her adımdaki farkındalıktır.\""
          }
        }
      }
    },
    "zen_backup_quote_6" : {
      "comment" : "Backup Zen quote 6",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"The clouds of thought come and go. You are the sky.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Düşünce bulutları gelir ve geçer. Sen gökyüzüsün.\""
          }
        }
      }
    },
    "zen_backup_quote_7" : {
      "comment" : "Backup Zen quote 7",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Right here, right now – eternity is hidden in this moment.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Tam burada, tam şimdi - sonsuzluk bu anda gizli.\""
          }
        }
      }
    },
    "zen_backup_quote_8" : {
      "comment" : "Backup Zen quote 8",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"An empty mind is where anything is possible.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Boş bir zihin, her şeyin mümkün olduğu yerdir.\""
          }
        }
      }
    },
    "zen_backup_quote_9" : {
      "comment" : "Backup Zen quote 9",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Peace is not sought outside, it is discovered within.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Barış dışarıda aranmaz, içeride keşfedilir.\""
          }
        }
      }
    },
    "zen_backup_quote_10" : {
      "comment" : "Backup Zen quote 10",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Breath is the bridge between body and mind.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Nefes, beden ve zihin arasındaki köprüdür.\""
          }
        }
      }
    },
    "zen_backup_quote_11" : {
      "comment" : "Backup Zen quote 11",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Come, see, accept. This is the way of Zen.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Gel, gör, kabul et. Bu Zen'in yoludur.\""
          }
        }
      }
    },
    "zen_backup_quote_12" : {
      "comment" : "Backup Zen quote 12",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"There is grace even in falling. Get up and keep going.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Düşüşte bile zarafet vardır. Kalk ve devam et.\""
          }
        }
      }
    },
    "zen_backup_quote_13" : {
      "comment" : "Backup Zen quote 13",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Patience is the fruit of wisdom.\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Sabır, bilgeliğin meyveleridir.\""
