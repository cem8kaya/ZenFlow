    "zen_opening_0" : {
      "comment" : "Empathetic opening 0",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I hear and understand you with all my heart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seni tüm kalbimle duyuyorum ve anlıyorum."
          }
        }
      }
    },
    "zen_opening_1" : {
      "comment" : "Empathetic opening 1",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for sharing this with me, you are not alone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu benimle paylaştığın için teşekkür ederim, yalnız değilsin."
          }
        }
      }
    },
    "zen_opening_2" : {
      "comment" : "Empathetic opening 2",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is very human to feel this emotion, I am with you to find a solution."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu duyguyu hissetmen çok insani, çözüm için yanındayım."
          }
        }
      }
    },
    "zen_opening_3" : {
      "comment" : "Empathetic opening 3",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let's take a deep breath; what you feel is temporary, but your essence is permanent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derin bir nefes alalım; hissettiklerin geçici, senin özün ise kalıcı."
          }
        }
      }
    },
    "zen_opening_4" : {
      "comment" : "Empathetic opening 4",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I understand you. Sometimes the mind can be noisy, but silence is always there."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seni anlıyorum. Bazen zihin gürültülü olabilir, ama sessizlik hep orada."
          }
        }
      }
    },
    "zen_opening_5" : {
      "comment" : "Empathetic opening 5",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Congratulations on your awareness, this is the first and most important step."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farkındalığın için seni tebrik ederim, bu ilk ve en önemli adım."
          }
        }
      }
    },
    "zen_opening_6" : {
      "comment" : "Empathetic opening 6",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sometimes you just need to stop and feel. I'm listening to you without judgment."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazen sadece durup hissetmek gerekir. Seni yargısızca dinliyorum."
          }
        }
      }
    },
    "zen_opening_7" : {
      "comment" : "Empathetic opening 7",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let's put aside what the mind says and listen to the voice of our heart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zihnin söylediklerini bir kenara bırakıp, kalbinin sesine kulak verelim."
          }
        }
      }
    },
    "zen_opening_8" : {
      "comment" : "Empathetic opening 8",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever you're feeling right now, make room for it. Let it pass."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu an hissettiğin her neyse, ona yer aç. Geçip gitmesine izin ver."
          }
        }
      }
    },
    "zen_opening_9" : {
      "comment" : "Empathetic opening 9",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I am honored to accompany you on your journey."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yolculuğunda sana eşlik etmekten onur duyuyorum."
          }
        }
      }
    },
