    },
    "exercise_triangle_name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triangle Breath"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üçgen Nefes"
          }
        }
      },
      "comment" : "Triangle Breathing Name"
    },
    "exercise_coherent_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equal-length inhales and exhales at about 6 breaths per minute. Balances your heart rhythm and supports calm focus throughout the day."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dakikada yaklaşık 6 nefesle eşit uzunlukta nefes alıp verme. Kalp ritmini dengeler, gün boyu sakin bir odak sağlar."
          }
        }
      },
      "comment" : "Coherent Breathing Description"
    },
    "exercise_sigh_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two short inhales through the nose followed by a long exhale through the mouth. One of the fastest ways to ease acute stress in just a few cycles."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burundan iki kısa nefes alıp ağızdan uzun nefes verme. Anlık stresi birkaç döngüde azaltmanın en hızlı yollarından biridir."
          }
        }
      },
      "comment" : "Physiological Sigh Description"
    },
    "exercise_triangle_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhale, hold, exhale: three equal steps. A gentler rhythm than box breathing, ideal for beginners."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al, tut, ver: üç eşit adım. Kutu nefesine göre daha yumuşak, yeni başlayanlar için ideal bir ritim."
          }
        }
      },
      "comment" : "Triangle Breathing Description"
    },
